{
	"name": "ingombro",
	"version": "1.3.0",
	"type": "module",
	"description": "Disk space analyzer and cleaner",
	"bin": {
		"ingombro": "src/tui/main.ts"
	},
	"scripts": {
		"start": "electrobun dev",
		"dev": "electrobun dev --watch",
		"build:canary": "electrobun build --env=canary",
		"build:stable": "electrobun build --env=stable",
		"tui": "bun src/tui/main.ts",
		"build:tui": "bun build src/tui/main.ts --compile --minify --outfile build-cli/ingombro",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@effect/platform-bun": "4.0.5",
		"@envsec/sdk": "^1.0.0-beta.15",
		"@opentui/core": "^0.6.6",
		"effect": "4.0.5",
		"electrobun": "1.16.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.7.2"
	}
}
